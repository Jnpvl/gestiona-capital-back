<!doctype html>
<html>
<body style="margin:0;padding:16px;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#2A2A2E">
  <p style="margin:0 0 16px">Nuevo mensaje desde el formulario de contacto del sitio.</p>
  <table style="border-collapse:collapse;font-size:14px">
    <tr>
      <td style="padding:4px 12px 4px 0;color:#555">Nombre</td>
      <td>{{nombre}}</td>
    </tr>
    <tr>
      <td style="padding:4px 12px 4px 0;color:#555">Empresa</td>
      <td>{{empresa}}</td>
    </tr>
    <tr>
      <td style="padding:4px 12px 4px 0;color:#555">Correo</td>
      <td>{{email}}</td>
    </tr>
    <tr>
      <td style="padding:4px 12px 4px 0;color:#555">Teléfono</td>
      <td>{{telefono}}</td>
    </tr>
    <tr>
      <td style="padding:4px 12px 4px 0;color:#555">Servicio</td>
      <td>{{servicio}}</td>
    </tr>
  </table>
  <p style="margin:16px 0 0;white-space:pre-wrap">{{mensaje}}</p>
</body>
</html>
