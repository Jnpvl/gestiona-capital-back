{{#if quote.text}}
<div style="margin:8px 0 20px;padding:14px 16px;border-left:4px solid #CAA24B;background:#FBF8F0">
  <p style="margin:0 0 6px;font-size:11px;letter-spacing:0.06em;text-transform:uppercase;color:#8A6D3B">{{quote.label}}</p>
  <p style="margin:0;font-size:15px;line-height:1.55;color:#2A2A2E">{{quote.text}}</p>
</div>
{{/if}}
