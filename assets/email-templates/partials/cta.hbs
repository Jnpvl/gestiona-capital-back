{{#if action.href}}
<p style="margin:24px 0 8px">
  <a href="{{action.href}}" style="display:inline-block;background:#2E3192;color:#ffffff;text-decoration:none;font-size:14px;font-weight:600;padding:13px 22px;border-radius:8px">
    {{action.label}}
  </a>
</p>
<p style="margin:0 0 18px;font-size:12px;line-height:1.5;color:#6B6B70;word-break:break-all">{{action.href}}</p>
{{/if}}
